# Copy to .env.local for local dev, and set the same values in the Vercel
# project's Environment Variables for deploys.

# NOTE: this file is COMMITTED to the repo. It documents which variables exist —
# never put real values in it. Real values go in .env.local (gitignored) or in
# the Vercel dashboard.

# --- Vercel Blob (saved comparisons) ---
# Set automatically on Vercel when the Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Zoho CRM + WorkDrive (server-side only; NEVER prefix with NEXT_PUBLIC_) ---
# From a "Self Client" at https://api-console.zoho.com with scopes:
#   ZohoCRM.coql.READ,ZohoCRM.modules.deals.READ,ZohoCRM.modules.contacts.READ,WorkDrive.files.CREATE
# The refresh token acts as the Zoho user who generated it, so that user must
# be able to see the enquiries and their WorkDrive folders.
ZOHO_CLIENT_ID=1000.XXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxx.xxxxxxxx
